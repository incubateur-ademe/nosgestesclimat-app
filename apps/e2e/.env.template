# Mailbox adapter: 'stub' (local stack) or 'brevo' (preprod gate)
E2E_MAILBOX=stub
E2E_MAILBOX_URL=http://localhost:3002

# Mock server port (optional, default 3002)
PORT=3002

# Preprod suite only: the site under test. The local suite derives it for each
# worker (http://localhost:310<i>, see stack/config.ts).
# NEXT_PUBLIC_SITE_URL=https://preprod.nosgestesclimat.fr

# Local suite only (tests/, except tests/preprod): globalSetup creates one
# database per worker (ngc_e2e_<i>) on this Postgres instance, and the tests
# seed them with core factories/services. Admin URL: any database the user can
# connect to (the e2e databases are created next to it).
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Tests sign in with a session that the site must decrypt: same value as the
# site under test.
SESSION_ENCRYPTION_KEY=
# Number of workers, hence of stacks (optional, default 3).
# E2E_WORKERS=3
# 'dev' runs a single stack on `next dev` instead of the patched builds
# (optional, no `build:site` needed).
# E2E_SITE_MODE=dev
