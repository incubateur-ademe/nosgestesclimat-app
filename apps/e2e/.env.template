# Site under test
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mailbox adapter: 'stub' (local stack) or 'brevo' (preprod gate)
E2E_MAILBOX=stub
E2E_MAILBOX_URL=http://localhost:3002

# Mock server port (optional, default 3002)
PORT=3002

# Local suite only (tests/, except tests/preprod): tests seed their data in the
# e2e database with core factories/services, and sign in with a session that
# the site must decrypt. Use the same values as the site under test.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ngc
SESSION_ENCRYPTION_KEY=
