# Mode mock local — utilisé par `pnpm -F server dev:e2e`.
# Ne contient QUE les surcharges : tout le reste (JWT_SECRET, DATABASE_URL,
# etc.) vient de `.env`. Le dernier `--env-file` gagne, donc ce fichier écrase
# les valeurs réelles des services tiers ci-dessous.

BREVO_URL=http://localhost:3002
BREVO_API_KEY=e2e
CONNECT_URL=http://localhost:3002
CONNECT_CLIENT_ID=e2e
CONNECT_CLIENT_SECRET=e2e
AGIR_URL=http://localhost:3002
AGIR_API_KEY=e2e
TWO_TONS_URL=http://localhost:3002
TWO_TONS_BEARER_TOKEN=e2e
MATOMO_BETA_URL=http://localhost:3002
MATOMO_BETA_TOKEN=e2e
