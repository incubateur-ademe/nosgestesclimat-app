# Mode mock local — chargé par les scripts `dev:e2e` / `start:e2e` du site.
#
# Le chargement passe par `NODE_OPTIONS="--require dotenv/config"` (et non par
# `node --env-file`, refusé dans NODE_OPTIONS car Next réinjecte
# `process.execArgv` dans ses workers) — cf. https://github.com/nodejs/node/issues/41103
#
# Le site appelle Brevo directement (server action dans core) : on le
# pointe vers le serveur mock (apps/e2e/mock). L'env du shell (CI) reste
# prioritaire (dotenv n'écrase pas les variables déjà définies).

BREVO_URL=http://localhost:3002
BREVO_API_KEY=e2e
