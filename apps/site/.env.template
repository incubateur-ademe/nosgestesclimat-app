DEEPL_API_KEY=
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ngc
# Connections this process keeps at most. One process per container: the fleet
# total is this value times the number of containers.
DATABASE_POOL_MAX=5

NEXT_PUBLIC_FORCE_AB_TEST=
CMS_TOKEN=
CMS_URL=
MATTERMOST_WEBHOOK_URL=
NEXT_PUBLIC_POLL_CONTEST_SLUGS=
NEXT_PUBLIC_AB_TESTS=
# Cypress
SCALINGO_APP_NAME=
SCALINGO_POSTGRESQL_URL=
DB_USER=
DB_PASSWORD=
DB_NAME=
VERIFICATION_CODE_EMAIL=
# For local evaluation of Posthog feature flags
# See https://posthog.com/docs/feature-flags/local-evaluation for more details
POSTHOG_PERSONAL_API_KEY=
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_API_HOST=https://nosgestesclimat.fr/revp
NEXT_PUBLIC_POSTHOG_KEY=
# OTLP export of the server logs and traces to PostHog (server-only). Leave the
# token empty to keep them on stdout only: local dev and tests never export.
POSTHOG_OTLP_ENDPOINT=https://eu.i.posthog.com/i
POSTHOG_PROJECT_TOKEN=
# Fraction of the traces exported, between 0 and 1. Lower it if the PostHog
# volume gets high: the logs keep their trace_id either way.
OTEL_TRACES_SAMPLER_RATIO=1
# Commit SHA of the deployed build, set by the deploy pipeline
# (env-set SOURCE_VERSION on the Scalingo app). Feeds the Sentry release and
# `service.version`: one string to join a span, a line and an issue.
SOURCE_VERSION=
# Same SHA, exposed to the browser bundle for the PostHog `serviceVersion`.
NEXT_PUBLIC_APP_VERSION=
# Sentry project of the app. Public by design (it ships in the browser
# bundle): keep both on the same project. Empty in local dev: nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_DATASHARE_BYPASS_ORIGINS=

SESSION_ENCRYPTION_KEY= # generate with `openssl rand -base64 32` (AES-256 key for session encryption)
INTERNAL_API_KEY= # generate with `openssl rand -base64 32` (secret shared with Express for x-internal-key header)

IRON_SESSION_PASSWORD= # generate with `openssl rand -base64 32`
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY= # generate with `openssl rand -base64 32` - required for multi-instance deployments

ENGINE_HOT_KEYS=FR:current
ENGINE_CACHE_MAX_SIZE=1

LOG_LEVEL=info
LOG_PRETTY=true

BREVO_URL=
BREVO_API_KEY=
