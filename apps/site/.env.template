DEEPL_API_KEY=
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ngc
# Connections this process keeps at most. One process per container: the fleet
# total is this value times the number of containers.
DATABASE_POOL_MAX=5

CMS_TOKEN=
CMS_URL=
MATTERMOST_WEBHOOK_URL=
NEXT_PUBLIC_POLL_CONTEST_SLUGS=
# Read by the Scalingo scripts (`scripts/`, `.github/`), not by the app itself.
SCALINGO_APP_NAME=
SCALINGO_POSTGRESQL_URL=
# Google Tag Manager container. Unset, no tag is injected.
NEXT_PUBLIC_GOOGLE_TAG_ID=
# Personal API key: local evaluation of Posthog feature flags (see
# https://posthog.com/docs/feature-flags/local-evaluation) and the source-map
# upload at build time. Both it and the project id below are required to build
# in production — without them, every stack trace stays minified.
POSTHOG_PERSONAL_API_KEY=
# PostHog project id, for the source-map upload: the numeric id of the project
# the personal key below may write to. A valid id for *another* project sends
# the maps there without a word — nothing in the build can tell, and the build
# still succeeds.
POSTHOG_PROJECT_ID=
# The PostHog app, not the ingestion API: posthog-js builds its links back to
# the interface from here. The `.i` subdomain ingests — pointing this at it
# breaks those links without a word, ingestion being unaffected.
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
# Where the browser sends: the site's reverse proxy, which dodges ad blockers.
NEXT_PUBLIC_POSTHOG_API_HOST=https://nosgestesclimat.fr/revp
# Where the server-side client (`posthog-node`) sends: direct, nothing to dodge.
# Unset, `posthogServer` stays a noop — flags answer `true`, in silence.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# The project token: inlined into the browser bundle (it identifies the project,
# not a secret — it already ships in the page), and read by the server for its
# OTLP export of logs and traces. One variable, both sides. Required in
# production.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# OTLP export of the server logs and traces to PostHog (server-only). Leave the
# token empty to keep them on stdout only: local dev and tests never export.
# Required in production.
POSTHOG_OTLP_ENDPOINT=https://eu.i.posthog.com/i
# Sentry project of the app. Public by design (the DSN ships in the browser
# bundle), and read from the environment by the browser, the server and the
# worker. Empty in local dev: nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=

SESSION_ENCRYPTION_KEY= # generate with `openssl rand -base64 32` (AES-256 key for session encryption)
INTERNAL_API_KEY= # generate with `openssl rand -base64 32` (secret shared with Express for x-internal-key header)

# Shared with the integrators allowed to bypass the data-share consent
# (`?bypass_key=`), checked by a server action. Unset, the bypass is silently
# inactive.
BYPASS_KEY=

IRON_SESSION_PASSWORD= # generate with `openssl rand -base64 32`
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY= # generate with `openssl rand -base64 32` - required for multi-instance deployments

# Comma-separated {region}:{version} keys, version being `current`, a published tag (4.14.2) or pr-{number}
ENGINE_HOT_KEYS=FR:current
ENGINE_CACHE_MAX_SIZE=1

LOG_PRETTY=true
# Verbosity of every logger, server and browser (console + PostHog Logs): a
# level, or `silent`. Empty: `debug` in local dev, `warn` otherwise.
NEXT_PUBLIC_LOG_VERBOSITY=

BREVO_URL=
BREVO_API_KEY=

REDIS_URL=redis://localhost:6379 # Redis instance shared with the Express server (rate limiting)

POLL_STATS_COOLDOWN_TIERS= # same value as the server, e.g. `100:0s|1000:15m|4h` (default when empty)
