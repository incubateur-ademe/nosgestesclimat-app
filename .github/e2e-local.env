# Local e2e stacks (CI and apps/e2e/stack) — test-only values. Safe to commit.
# Third-party URLs (Brevo/Connect/Agir/TwoTons/Matomo) are pointed at the mock
# by each app's `.env.e2e` (apps/server/.env.e2e, apps/site/.env.e2e).

# Server — shared security + non-mocked third-party keys required by the schema
# No NODE_ENV here: the server defaults to development, and the site (next
# build/start) defaults to production.
# `e2e` is the profile of the local e2e stack: it is where test-only behaviour
# (logging, seeding, disabling side effects…) can be plugged, and it allows
# http://localhost on any port for CORS — see ALLOWED_ORIGINS_BY_APP_ENV.
APP_ENV=e2e
JOB_SECRET=e2e-job-secret
INTERNAL_API_KEY=e2e-internal-api-key
NOTION_API_KEY=e2e
NOTION_ACTION_DATABASE_ID=e2e
SCALEWAY_ACCESS_KEY_ID=e2e
SCALEWAY_SECRET_ACCESS_KEY=e2e
SCALEWAY_BUCKET=e2e

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Inlined by the build like the site URL, so that each e2e stack's copy of the
# build can point it at its own API (apps/e2e/stack/builds.ts).
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
SERVER_AUTH_COOKIE_NAME=ngc_server_auth_jwt
# SESSION_ENCRYPTION_KEY is provided as a GitHub secret (Test E2E env).
# IRON_SESSION_PASSWORD is a plain-text dummy.
IRON_SESSION_PASSWORD=e2e-fake-iron-session-password-not-a-secret
NEXT_PUBLIC_LOG_VERBOSITY=warn
